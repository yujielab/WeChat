{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wechat-glass",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // The UI is plain static files; only /api and /auth run the Worker first.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },

  // One Durable Object instance holds the WeChat web session, polls for
  // messages and stores them, so nothing is lost while the phone sleeps.
  "durable_objects": {
    "bindings": [{ "name": "WX", "class_name": "WeChatSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WeChatSession"] }],

  "vars": {
    // Where the Durable Object is created on first use. WeChat's servers are in
    // mainland China, so Asia-Pacific keeps polling latency low.
    "DO_LOCATION_HINT": "apac"
  }

  // Secrets (set with `npx wrangler secret put <NAME>`):
  //   APP_PASSWORD       required — password for this web app
  //   VAPID_PUBLIC_KEY   optional — Web Push (generate with `npm run vapid`)
  //   VAPID_PRIVATE_KEY  optional
  //   VAPID_SUBJECT      optional — e.g. mailto:you@example.com
}
