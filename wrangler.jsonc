{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wechatduo",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // Preserve the existing production custom domain on Git-based deployments.
  "routes": [
    { "pattern": "wechat.cuven.us", "zone_name": "cuven.us", "custom_domain": true }
  ],

  // The UI is plain static files; only /api, /auth and /rtc run the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/rtc/*"]
  },

  // One Durable Object is the whole backend hub: accounts, contacts, rooms,
  // messages, presence, the realtime WebSocket fan-out and call signaling.
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  // v1 was already deployed by the WeChat client. Never rewrite an applied
  // migration: create the new hub separately and retain the old namespace.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WeChatSession"] },
    { "tag": "v2", "new_sqlite_classes": ["Hub"] }
  ],

  // Images, voice clips, files and avatars live in R2.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "cf-messenger-media" }],

  "vars": {
    // Where the Durable Object is created on first use.
    "DO_LOCATION_HINT": "apac"
  },
  // Variables added in the dashboard (Settings › Variables and Secrets) stay
  // across deploys from main instead of being cleared by each one.
  "keep_vars": true,

  // Pull-request builds run `wrangler preview`, which needs its own bindings.
  // Each Preview gets a fresh, isolated hub (accounts, rooms, messages), and
  // media goes to a separate bucket, so a Preview never touches production
  // data. Create that bucket once:
  //   npx wrangler r2 bucket create cf-messenger-media-preview
  // Previews don't inherit production secrets (set them with
  // `npx wrangler preview secret`); without SIGNUP_CODE sign-up is open and
  // without REALTIME_* calls are off, which suits a throwaway Preview.
  "previews": {
    "vars": { "DO_LOCATION_HINT": "apac" },
    "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
    "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "cf-messenger-media-preview" }]
  }

  // Secrets (set with `npx wrangler secret put <NAME>`, or in the dashboard
  // with type Secret; never in "vars" above, the repository is public):
  //   SIGNUP_CODE          optional — required invite code to register
  //   REALTIME_APP_ID      Cloudflare Realtime (Calls) SFU app id, for calls
  //   REALTIME_APP_SECRET  Cloudflare Realtime app secret
  //   REALTIME_TURN_KEY_ID      optional — Realtime TURN key id (NAT traversal)
  //   REALTIME_TURN_KEY_TOKEN   optional — Realtime TURN key token
  //   VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY / VAPID_SUBJECT  optional — Web Push;
  //     without them the hub generates a key pair once and keeps it
  //   TELEGRAM_BOT_TOKEN   optional — a Telegram bot's token, to read sticker
  //     packs (without it there are no stickers)
  // Optional plain variable (dashboard, type Text): STICKER_SETS — the packs a
  // new account starts with, comma separated (default HandDrawnEmoji,GameEmoji).
  // Everyone adds or removes packs in the app, from these and the preset
  // table in src/stickers.js.
}
